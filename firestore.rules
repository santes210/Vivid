rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────
    //  Helpers
    // ─────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Contenido de una cuenta privada: únicamente el autor y seguidores
    // aceptados. Las solicitudes pendientes no crean el doc /followers/{uid}.
    function canReadOwnedContent(authorId, isPrivate) {
      return signedIn() && (
        request.auth.uid == authorId
        || isPrivate == false
        || exists(/databases/$(database)/documents/users/$(authorId)/followers/$(request.auth.uid))
      );
    }

    function matchesAuthorPrivacy(authorId, isPrivate) {
      return isPrivate == getAfter(/databases/$(database)/documents/users/$(authorId)).data.get('isPrivate', false);
    }

    function canReadPost(postId) {
      let post = get(/databases/$(database)/documents/posts/$(postId)).data;
      return canReadOwnedContent(post.userId, post.get('isPrivate', true));
    }

    function canReadReel(reelId) {
      let reel = get(/databases/$(database)/documents/reels/$(reelId)).data;
      return canReadOwnedContent(reel.userId, reel.get('isPrivate', true));
    }

    // Claves que cambian en este update.
    function changedKeys() {
      return request.resource.data.diff(resource.data).changedKeys();
    }

    // El update solo toca las claves indicadas (ninguna otra).
    function onlyChanges(fields) {
      return changedKeys().hasOnly(fields);
    }

    function touches(field) {
      return changedKeys().hasAny([field]);
    }

    // Valor numérico anterior (0 si el campo aún no existía).
    function oldNum(field) {
      return resource.data.get(field, 0);
    }

    // Un contador solo puede moverse de a 1 y nunca quedar negativo.
    // Esto es lo que impide que alguien escriba likesCount = 999999.
    //
    // Nota: si un contador quedara desincronizado en 0 con relaciones vivas
    // (datos viejos de cuando las reglas eran permisivas), el -1 se rechaza y
    // hay que corregir el valor a mano en la consola. En operación normal no
    // pasa: contador y subcolección se escriben juntos en el mismo batch.
    function stepsByOne(field) {
      return !touches(field) || (
        (request.resource.data[field] == oldNum(field) + 1 ||
         request.resource.data[field] == oldNum(field) - 1)
        && request.resource.data[field] >= 0
      );
    }

    // Un contador que solo puede subir de a 1 (vistas).
    function incrementsByOne(field) {
      return !touches(field) || request.resource.data[field] == oldNum(field) + 1;
    }

    // Un acumulador que solo puede crecer (watch time).
    function onlyGrows(field) {
      return !touches(field) || request.resource.data[field] >= oldNum(field);
    }

    // ─────────────────────────────────────────────────
    //  Likes (collection group)
    // ─────────────────────────────────────────────────
    // El feed y la hoja de comentarios cargan "qué ya likeé yo" con UNA
    // query de collectionGroup("likes").whereEqualTo("userId", uid).
    // Las queries de collectionGroup NO se autorizan con los match de ruta
    // específica (posts/{id}/likes, reels/{id}/likes, ...): Firestore exige
    // un match de grupo /{path=**}/likes. Sin esto, la query fallaba con
    // PERMISSION_DENIED en silencio, el corazón salía siempre apagado y
    // cada tap volvía a sumar +1 al contador (likes infinitos).
    match /{path=**}/likes/{likeId} {
      allow read: if signedIn();
    }

    // ─────────────────────────────────────────────────
    //  Usuarios
    // ─────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isUser(userId);

      // El dueño edita su perfil libremente.
      // Un tercero SOLO puede mover followersCount / followingCount de a 1
      // (necesario para follow / unfollow / aceptar solicitud, que escriben
      // en el documento del otro usuario con FieldValue.increment).
      allow update: if isUser(userId) || (
        signedIn()
        && onlyChanges(['followersCount', 'followingCount', 'updatedAt', 'uid'])
        && stepsByOne('followersCount')
        && stepsByOne('followingCount')
      );

      // Solo el propio dueño puede borrar su cuenta
      // (AccountRepository.closeAccountAndPurgeData).
      allow delete: if isUser(userId);

      match /followers/{docId} {
        allow read: if signedIn();
        // En cuentas privadas solo el propietario puede aceptar y crear el
        // vínculo. En públicas, el propio seguidor puede seguir directamente.
        allow create, update: if isUser(userId) || (
          isUser(docId)
          && get(/databases/$(database)/documents/users/$(userId)).data.get('isPrivate', false) == false
        );
        allow delete: if isUser(userId) || isUser(docId);
      }

      match /following/{docId} {
        allow read: if signedIn();
        // userId es quien sigue y docId es la cuenta seguida. Una cuenta
        // privada crea este lado del vínculo al aceptar la solicitud.
        allow create, update: if isUser(docId) || (
          isUser(userId)
          && get(/databases/$(database)/documents/users/$(docId)).data.get('isPrivate', false) == false
        );
        allow delete: if isUser(userId) || isUser(docId);
      }

      match /followRequests/{docId} {
        allow read: if isUser(userId) || isUser(docId);
        allow create, update, delete: if isUser(userId) || isUser(docId);
      }

      match /sentFollowRequests/{docId} {
        allow read: if isUser(userId);
        allow create, update, delete: if isUser(userId) || isUser(docId);
      }

      match /savedPosts/{postId} {
        allow read, create, update, delete: if isUser(userId);
      }

      // FCM Tokens — el usuario gestiona sus propios tokens de push
      match /fcmTokens/{token} {
        allow read, create, update, delete: if isUser(userId);
      }
    }

    // ─────────────────────────────────────────────────
    //  Posts
    // ─────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if canReadOwnedContent(resource.data.userId, resource.data.get('isPrivate', true));

      // Un post nace siempre con los contadores en cero y la privacidad
      // desnormalizada coincide con el perfil actual del autor.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && matchesAuthorPrivacy(request.auth.uid, request.resource.data.isPrivate)
        && request.resource.data.get('likesCount', 0) == 0
        && request.resource.data.get('commentsCount', 0) == 0;

      // El autor edita su post (caption, etc.) pero no puede cambiar de dueño.
      // Un tercero solo mueve likesCount / commentsCount de a 1.
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && (request.resource.data.isPrivate == true
            || matchesAuthorPrivacy(request.auth.uid, request.resource.data.isPrivate)))
        || (
          canReadOwnedContent(resource.data.userId, resource.data.get('isPrivate', true))
          && onlyChanges(['likesCount', 'commentsCount'])
          && stepsByOne('likesCount')
          && stepsByOne('commentsCount')
        )
      );

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if canReadPost(postId);
        allow create: if canReadPost(postId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.get('likesCount', 0) == 0;

        allow update: if canReadPost(postId) && (
          (resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId)
          || (onlyChanges(['likesCount']) && stepsByOne('likesCount'))
        );

        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
        );

        match /likes/{userId} {
          allow read: if signedIn();
          // userId dentro del doc debe coincidir: el feed consulta estos likes
          // por collectionGroup con whereEqualTo("userId", uid).
          // set() sobre un doc que ya existe cuenta como update, no como
          // create, así que hay que permitir ambos o el segundo like falla
          // con PERMISSION_DENIED.
          allow create, update: if canReadPost(postId)
            && isUser(userId)
            && request.resource.data.userId == request.auth.uid;
          allow delete: if isUser(userId);
        }
      }

      match /likes/{userId} {
        allow read: if signedIn();
        // set() sobre un doc que ya existe cuenta como update, no como
        // create, así que hay que permitir ambos o el segundo like falla
        // con PERMISSION_DENIED.
        allow create, update: if canReadPost(postId)
          && isUser(userId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isUser(userId);
      }
    }

    // ─────────────────────────────────────────────────
    //  Stories
    // ─────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if canReadOwnedContent(resource.data.userId, resource.data.get('isPrivate', true));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && matchesAuthorPrivacy(request.auth.uid, request.resource.data.isPrivate);

      // Solo el autor edita la story. Un tercero únicamente suma +1 a
      // viewersCount al verla por primera vez (StoryViewerScreen).
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && (request.resource.data.isPrivate == true
            || matchesAuthorPrivacy(request.auth.uid, request.resource.data.isPrivate)))
        || (canReadOwnedContent(resource.data.userId, resource.data.get('isPrivate', true))
          && onlyChanges(['viewersCount']) && incrementsByOne('viewersCount'))
      );

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      // Vistas: quién vio la story
      match /viewers/{viewerId} {
        allow read: if canReadOwnedContent(
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId,
          get(/databases/$(database)/documents/stories/$(storyId)).data.get('isPrivate', true)
        );
        allow create, update: if canReadOwnedContent(
            get(/databases/$(database)/documents/stories/$(storyId)).data.userId,
            get(/databases/$(database)/documents/stories/$(storyId)).data.get('isPrivate', true)
          ) && isUser(viewerId)
          && request.resource.data.get('uid', viewerId) == viewerId;
        allow delete: if isUser(viewerId)
          || get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
      }
    }

    // ─────────────────────────────────────────────────
    //  Reels
    // ─────────────────────────────────────────────────
    match /reels/{reelId} {
      allow read: if canReadOwnedContent(resource.data.userId, resource.data.get('isPrivate', true));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && matchesAuthorPrivacy(request.auth.uid, request.resource.data.isPrivate)
        && request.resource.data.get('likes', 0) == 0
        && request.resource.data.get('comments', 0) == 0;

      // Autor: control total. Tercero: likes/comments de a 1, más las
      // métricas de ReelAnalyticsTracker (que solo pueden crecer).
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && (request.resource.data.isPrivate == true
            || matchesAuthorPrivacy(request.auth.uid, request.resource.data.isPrivate)))
        || (
          canReadOwnedContent(resource.data.userId, resource.data.get('isPrivate', true))
          && onlyChanges(['likes', 'comments', 'viewsCount', 'completedViews', 'totalWatchTimeSec'])
          && stepsByOne('likes')
          && stepsByOne('comments')
          && incrementsByOne('viewsCount')
          && incrementsByOne('completedViews')
          && onlyGrows('totalWatchTimeSec')
        )
      );

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      // Analytics de vistas únicas (ReelAnalyticsTracker.trackView).
      // Antes no existía esta regla, así que la escritura fallaba en silencio.
      match /viewers/{viewerId} {
        allow read: if canReadReel(reelId);
        allow create, update: if canReadReel(reelId) && isUser(viewerId);
        allow delete: if isUser(viewerId)
          || get(/databases/$(database)/documents/reels/$(reelId)).data.userId == request.auth.uid;
      }

      match /likes/{userId} {
        allow read: if canReadReel(reelId);
        // set() sobre un doc que ya existe cuenta como update, no como
        // create, así que hay que permitir ambos o el segundo like falla
        // con PERMISSION_DENIED.
        allow create, update: if canReadReel(reelId) && isUser(userId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isUser(userId);
      }

      match /comments/{commentId} {
        allow read: if canReadReel(reelId);
        allow create: if canReadReel(reelId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.get('likesCount', 0) == 0;

        allow update: if canReadReel(reelId) && (
          (resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId)
          || (onlyChanges(['likesCount']) && stepsByOne('likesCount'))
        );

        allow delete: if signedIn() && (
          request.auth.uid == resource.data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/reels/$(reelId)).data.userId
        );

        match /likes/{userId} {
          allow read: if signedIn();
          // set() sobre un doc que ya existe cuenta como update, no como
          // create, así que hay que permitir ambos o el segundo like falla
          // con PERMISSION_DENIED.
          allow create, update: if isUser(userId)
            && request.resource.data.userId == request.auth.uid;
          allow delete: if isUser(userId);
        }
      }
    }

    // ─────────────────────────────────────────────────
    //  Chats
    // ─────────────────────────────────────────────────
    match /chats/{chatId} {
  function hasValidParticipants(data) {
    return data.participants is list
      && data.participants.size() == 2;
  }

  function isParticipant() {
    return signedIn()
      && resource.data.participants is list
      && request.auth.uid in resource.data.participants;
  }

  // El id de un DM es uidA_uidB (ordenados). Solo se permite sondear
  // un chat INEXISTENTE si el uid actual aparece en ese id: así el
  // transaction.get() de ensureChatExists / persistOutgoingMessage no
  // revienta, y un extraño no enumera conversaciones ajenas.
  function isMissingChatIBelongTo() {
    return !exists(/databases/$(database)/documents/chats/$(chatId))
      && (
        chatId.matches(request.auth.uid + '_.*')
        || chatId.matches('.*_' + request.auth.uid)
      );
  }

  // GET de un participante sobre su conversación.
  // También se permite el get de un chat que TODAVÍA no existe y cuyo
  // id incluye al usuario: el flujo de una conversación nueva hace
  // transaction.get(chats/{chatId}) ANTES de crear el documento
  // (ensureChatExists / persistOutgoingMessage). Como resource es null
  // cuando el documento no existe, evaluar resource.data.participants
  // ahí resulta en PERMISSION_DENIED y NINGUNA cuenta podría iniciar
  // un chat nuevo: solo seguirían funcionando las conversaciones ya
  // creadas (el síntoma "las cuentas viejas sí pueden escribir").
  // Permitir este get no filtra datos: la respuesta es "no existe".
  //
  // IMPORTANTE: isMissingChatIBelongTo() va ANTES de isParticipant()
  // porque && / || cortocircuitan, y acceder a resource.data cuando
  // el documento no existe aborta toda la regla (queda denegada).
  allow get: if signedIn() && (
    isMissingChatIBelongTo() || isParticipant()
  );

  // Las queries (lista de chats, whereArrayContains participants)
  // solo ven conversaciones en las que el usuario ya participa.
  allow list: if isParticipant();

  allow create: if signedIn()
    && hasValidParticipants(request.resource.data)
    && request.auth.uid in request.resource.data.participants;

  allow update: if isParticipant()
    && hasValidParticipants(request.resource.data)
    && request.resource.data.participants.hasOnly(resource.data.participants)
    && resource.data.participants.hasOnly(request.resource.data.participants);

  allow delete: if false;

  match /messages/{messageId} {
    function chatPath() {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function existingChatParticipants() {
      return get(chatPath()).data.participants;
    }

    function resultingChatParticipants() {
      return getAfter(chatPath()).data.participants;
    }

    function inExistingChat() {
      return signedIn()
        && exists(chatPath())
        && get(chatPath()).data.participants is list
        && request.auth.uid in existingChatParticipants();
    }

    function inResultingChat() {
      return signedIn()
        && existsAfter(chatPath())
        && getAfter(chatPath()).data.participants is list
        && request.auth.uid in resultingChatParticipants();
    }

    allow read: if inExistingChat();

    allow create: if inResultingChat()
      && request.resource.data.senderId == request.auth.uid
      && request.resource.data.receiverId in resultingChatParticipants()
      && request.resource.data.get('type', 'text')
        in ['text', 'image', 'voice', 'story_reply'];

    allow update: if inExistingChat() && (
      onlyChanges([
        'isRead',
        'isDelivered',
        'reaction',
        'imageUrl',
        'voiceUrl'
      ])
      || (
        resource.data.senderId == request.auth.uid
        && resource.data.get('type', 'text') == 'text'
        && onlyChanges(['text', 'lastEditedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 4000
        && request.resource.data.lastEditedAt is int
        && request.resource.data.lastEditedAt >
          resource.data.get('lastEditedAt', 0)
      )
    );

    allow delete: if inExistingChat()
      && resource.data.senderId == request.auth.uid;
  }
}

  }
}
