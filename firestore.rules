rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────
    //  Helpers
    // ─────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Claves que cambian en este update.
    function changedKeys() {
      return request.resource.data.diff(resource.data).changedKeys();
    }

    // El update solo toca las claves indicadas (ninguna otra).
    function onlyChanges(fields) {
      return changedKeys().hasOnly(fields);
    }

    function touches(field) {
      return changedKeys().hasAny([field]);
    }

    // Valor numérico anterior (0 si el campo aún no existía).
    function oldNum(field) {
      return resource.data.get(field, 0);
    }

    // Un contador solo puede moverse de a 1 y nunca quedar negativo.
    // Esto es lo que impide que alguien escriba likesCount = 999999.
    //
    // Nota: si un contador quedara desincronizado en 0 con relaciones vivas
    // (datos viejos de cuando las reglas eran permisivas), el -1 se rechaza y
    // hay que corregir el valor a mano en la consola. En operación normal no
    // pasa: contador y subcolección se escriben juntos en el mismo batch.
    function stepsByOne(field) {
      return !touches(field) || (
        (request.resource.data[field] == oldNum(field) + 1 ||
         request.resource.data[field] == oldNum(field) - 1)
        && request.resource.data[field] >= 0
      );
    }

    // Un contador que solo puede subir de a 1 (vistas).
    function incrementsByOne(field) {
      return !touches(field) || request.resource.data[field] == oldNum(field) + 1;
    }

    // Un acumulador que solo puede crecer (watch time).
    function onlyGrows(field) {
      return !touches(field) || request.resource.data[field] >= oldNum(field);
    }

    // ─────────────────────────────────────────────────
    //  Usuarios
    // ─────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isUser(userId);

      // El dueño edita su perfil libremente.
      // Un tercero SOLO puede mover followersCount / followingCount de a 1
      // (necesario para follow / unfollow / aceptar solicitud, que escriben
      // en el documento del otro usuario con FieldValue.increment).
      allow update: if isUser(userId) || (
        signedIn()
        && onlyChanges(['followersCount', 'followingCount', 'updatedAt', 'uid'])
        && stepsByOne('followersCount')
        && stepsByOne('followingCount')
      );

      // Solo el propio dueño puede borrar su cuenta
      // (AccountRepository.closeAccountAndPurgeData).
      allow delete: if isUser(userId);

      match /followers/{docId} {
        allow read: if signedIn();
        // create+update: se escribe con batch.set(), que cuenta como update
        // si el doc ya existía (p. ej. volver a seguir a alguien).
        allow create, update, delete: if isUser(userId) || isUser(docId);
      }

      match /following/{docId} {
        allow read: if signedIn();
        allow create, update, delete: if isUser(userId) || isUser(docId);
      }

      match /followRequests/{docId} {
        allow read: if isUser(userId) || isUser(docId);
        allow create, update, delete: if isUser(userId) || isUser(docId);
      }

      match /sentFollowRequests/{docId} {
        allow read: if isUser(userId);
        allow create, update, delete: if isUser(userId) || isUser(docId);
      }

      match /savedPosts/{postId} {
        allow read, create, update, delete: if isUser(userId);
      }

      // FCM Tokens — el usuario gestiona sus propios tokens de push
      match /fcmTokens/{token} {
        allow read, create, update, delete: if isUser(userId);
      }
    }

    // ─────────────────────────────────────────────────
    //  Posts
    // ─────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if signedIn();

      // Un post nace siempre con los contadores en cero.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('likesCount', 0) == 0
        && request.resource.data.get('commentsCount', 0) == 0;

      // El autor edita su post (caption, etc.) pero no puede cambiar de dueño.
      // Un tercero solo mueve likesCount / commentsCount de a 1.
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId)
        || (
          onlyChanges(['likesCount', 'commentsCount'])
          && stepsByOne('likesCount')
          && stepsByOne('commentsCount')
        )
      );

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.get('likesCount', 0) == 0;

        allow update: if signedIn() && (
          (resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId)
          || (onlyChanges(['likesCount']) && stepsByOne('likesCount'))
        );

        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
        );

        match /likes/{userId} {
          allow read: if signedIn();
          // userId dentro del doc debe coincidir: el feed consulta estos likes
          // por collectionGroup con whereEqualTo("userId", uid).
          // set() sobre un doc que ya existe cuenta como update, no como
          // create, así que hay que permitir ambos o el segundo like falla
          // con PERMISSION_DENIED.
          allow create, update: if isUser(userId)
            && request.resource.data.userId == request.auth.uid;
          allow delete: if isUser(userId);
        }
      }

      match /likes/{userId} {
        allow read: if signedIn();
        // set() sobre un doc que ya existe cuenta como update, no como
        // create, así que hay que permitir ambos o el segundo like falla
        // con PERMISSION_DENIED.
        allow create, update: if isUser(userId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isUser(userId);
      }
    }

    // ─────────────────────────────────────────────────
    //  Stories
    // ─────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;

      // Solo el autor edita la story. Un tercero únicamente suma +1 a
      // viewersCount al verla por primera vez (StoryViewerScreen).
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (onlyChanges(['viewersCount']) && incrementsByOne('viewersCount'))
      );

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      // Vistas: quién vio la story
      match /viewers/{viewerId} {
        allow read: if signedIn();
        allow create, update: if isUser(viewerId)
          && request.resource.data.get('uid', viewerId) == viewerId;
        allow delete: if isUser(viewerId)
          || get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
      }
    }

    // ─────────────────────────────────────────────────
    //  Reels
    // ─────────────────────────────────────────────────
    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('likes', 0) == 0
        && request.resource.data.get('comments', 0) == 0;

      // Autor: control total. Tercero: likes/comments de a 1, más las
      // métricas de ReelAnalyticsTracker (que solo pueden crecer).
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId)
        || (
          onlyChanges(['likes', 'comments', 'viewsCount', 'completedViews', 'totalWatchTimeSec'])
          && stepsByOne('likes')
          && stepsByOne('comments')
          && incrementsByOne('viewsCount')
          && incrementsByOne('completedViews')
          && onlyGrows('totalWatchTimeSec')
        )
      );

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      // Analytics de vistas únicas (ReelAnalyticsTracker.trackView).
      // Antes no existía esta regla, así que la escritura fallaba en silencio.
      match /viewers/{viewerId} {
        allow read: if signedIn();
        allow create, update: if isUser(viewerId);
        allow delete: if isUser(viewerId)
          || get(/databases/$(database)/documents/reels/$(reelId)).data.userId == request.auth.uid;
      }

      match /likes/{userId} {
        allow read: if signedIn();
        // set() sobre un doc que ya existe cuenta como update, no como
        // create, así que hay que permitir ambos o el segundo like falla
        // con PERMISSION_DENIED.
        allow create, update: if isUser(userId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isUser(userId);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.get('likesCount', 0) == 0;

        allow update: if signedIn() && (
          (resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId)
          || (onlyChanges(['likesCount']) && stepsByOne('likesCount'))
        );

        allow delete: if signedIn() && (
          request.auth.uid == resource.data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/reels/$(reelId)).data.userId
        );

        match /likes/{userId} {
          allow read: if signedIn();
          // set() sobre un doc que ya existe cuenta como update, no como
          // create, así que hay que permitir ambos o el segundo like falla
          // con PERMISSION_DENIED.
          allow create, update: if isUser(userId)
            && request.resource.data.userId == request.auth.uid;
          allow delete: if isUser(userId);
        }
      }
    }

    // ─────────────────────────────────────────────────
    //  Chats
    // ─────────────────────────────────────────────────
    match /chats/{chatId} {
      function hasValidParticipants(data) {
        return data.participants is list
          && data.participants.size() == 2;
      }

      function isParticipant() {
        return signedIn()
          && hasValidParticipants(resource.data)
          && request.auth.uid in resource.data.participants;
      }

      allow read: if isParticipant();

      allow create: if signedIn()
        && hasValidParticipants(request.resource.data)
        && request.auth.uid in request.resource.data.participants;

      // Un participante puede actualizar metadata y la preview, pero nunca
      // agregar o quitar usuarios. La comparación es por conjunto para seguir
      // aceptando APKs anteriores que invertían el orden [emisor, receptor].
      allow update: if isParticipant()
        && hasValidParticipants(request.resource.data)
        && request.resource.data.participants.hasOnly(resource.data.participants)
        && resource.data.participants.hasOnly(request.resource.data.participants);

      allow delete: if false;

      match /messages/{messageId} {
        function chatPath() {
          return /databases/$(database)/documents/chats/$(chatId);
        }
        function existingChatParticipants() {
          return get(chatPath()).data.participants;
        }
        function resultingChatParticipants() {
          // getAfter permite crear el chat padre y el primer mensaje en la
          // misma transacción, eliminando la carrera que rompía el primer envío.
          return getAfter(chatPath()).data.participants;
        }
        function inExistingChat() {
          return signedIn()
            && exists(chatPath())
            && get(chatPath()).data.participants is list
            && request.auth.uid in existingChatParticipants();
        }
        function inResultingChat() {
          return signedIn()
            && existsAfter(chatPath())
            && getAfter(chatPath()).data.participants is list
            && request.auth.uid in resultingChatParticipants();
        }

        allow read: if inExistingChat();

        allow create: if inResultingChat()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in resultingChatParticipants()
          && request.resource.data.get('type', 'text') in ['text', 'image', 'voice', 'story_reply'];

        // Tanto emisor como receptor pueden actualizar únicamente acuses,
        // reacción y URLs firmadas. Nadie puede reescribir texto, dueño o tipo.
        allow update: if inExistingChat()
          && onlyChanges(['isRead', 'isDelivered', 'reaction', 'imageUrl', 'voiceUrl']);

        // Borrar solo lo propio (la UI ya solo ofrece la opción al autor).
        allow delete: if inExistingChat()
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
