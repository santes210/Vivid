# =====================================================
#  Vivid - .gitignore (seguro para repo publico)
# =====================================================

# Credenciales locales
local.properties
*.keystore
*.jks

# Cualquier archivo de secretos, en cualquier subcarpeta.
# OJO: un patron con barras se ancla a la raiz del repo, por eso el
# antiguo "app/src/main/.../BuildConfigSecrets.kt" NO coincidia con la
# ruta real "vivid-app/app/src/main/...".
**/BuildConfigSecrets.kt

# google-services.json ya NO se versiona (dejó de estar commiteado en el PR
# de seguridad). El build lo necesita, así que:
#   - En CI (GitHub Actions) se inyecta desde el secret GOOGLE_SERVICES_JSON_BASE64.
#   - En local, descárgalo de Firebase Console (Project settings → Your apps →
#     Android app → google-services.json) y colócalo en vivid-app/app/.
# Contiene la API key y el app id de Android: no son secretos de servidor,
# pero versionarlos en un repo público facilita el abuso (spam, clonación de
# la app), así que es mejor práctica inyectarlo en CI.
**/google-services.json

# Build outputs
node_modules/
.wrangler/
/build
/app/build
**/build/
*.apk
*.aab

# IDE
.idea/
*.iml
.vscode/

# Gradle
.gradle/
.kotlin/

# Secrets locales (por si acaso)
secrets.properties
*.env
.env.local

# Esquemas JSON exportados por Room en cada build.
# Generados automáticamente; el workflow build-apk.yml los sube como
# artefacto para poder commitearlos manualmente si se quieren versionar.
vivid-app/app/schemas/

# Entorno local del sandbox / maquina de desarrollo (no pertenecen al repo)
.sdkman/
.bashrc
.zshrc
.wget-hsts
uploads/

# Sin documentación .md en el repo. La información va en strings.xml
# (traducible) o en código (VividChangelog, Ajustes → Acerca de).
*.md
**/*.md
# Excepciones: guías de migración y documentación de arquitectura.
!KMP_MIGRATION_GUIDE.md
!vivid-app/KMP_MIGRATION_GUIDE.md

# iOS GoogleService-Info.plist — mismo tratamiento que google-services.json
# Contiene API key y app id de iOS. Se inyecta desde secret en CI.
**/GoogleService-Info.plist

# iOS / Xcode
*.xcworkspace
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
iosApp/Pods/
iosApp/Podfile.lock

# KMP framework output
shared/build/xcode-frameworks/
shared/build/bin/
