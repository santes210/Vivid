package com.vivid.app.di

/**
 * PLANTILLA — NO contiene claves reales y NO se compila (.example).
 *
 * Las claves de Backblaze B2 ya NO se commitear en este repositorio.
 * Se inyectan en `BuildConfig` desde `app/build.gradle.kts`, que las lee en
 * este orden de prioridad:
 *
 *   1. Variables de entorno (las usa GitHub Actions con secrets del repo):
 *        B2_KEY_ID, B2_APPLICATION_KEY, B2_BUCKET_ID, B2_BUCKET_NAME
 *   2. Propiedades de Gradle:  ./gradlew assembleDebug -Pb2KeyId=...
 *   3. local.properties (gitignored):
 *        b2.keyId=...
 *        b2.applicationKey=...
 *        b2.bucketId=...
 *        b2.bucketName=...
 *
 * El código de producción lee `com.vivid.app.BuildConfig.B2_*` directamente
 * (ver StorageModule.kt). Si quieres conservar un objeto de conveniencia en
 * tu copia local, copia este archivo como `BuildConfigSecrets.kt` y rellena
 * las constantes con tus valores; quedará ignorado por git gracias al patrón
 * `**/BuildConfigSecrets.kt` del .gitignore raíz.
 *
 * ⚠️ MODO DIRECTO = TEMPORAL. La solución segura es la Cloud Function de
 * /cloud-function (ver SECURITY.md): ahí las claves viven en
 * `firebase functions:config:set b2.*` y el APK solo habla con la función
 * usando un ID token de Firebase Auth.
 */
object BuildConfigSecrets {

    // BACKBLAZE B2 — completar SOLO en la copia local (no commitear)
    const val B2_ACCOUNT_ID       = ""
    const val B2_KEY_ID           = ""
    const val B2_APPLICATION_KEY  = ""
    const val B2_BUCKET_ID        = ""
    const val B2_BUCKET_NAME      = ""

    // CLOUD FUNCTION - URL base (PÚBLICA, ok tenerla en el código)
    const val CF_BASE_URL = "https://us-central1-TU_PROYECTO.cloudfunctions.net"
}
