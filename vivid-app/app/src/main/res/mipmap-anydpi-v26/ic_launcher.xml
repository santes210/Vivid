<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo sólido de la marca: evita el icono flotante en launchers modernos. -->
    <background android:drawable="@color/ic_launcher_background" />
    <!-- Logo vectorial, nítido en cualquier densidad. -->
    <foreground android:drawable="@drawable/ic_launcher_monochrome" />
    <!-- Android 13+ puede teñir el logo con Material You. -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
