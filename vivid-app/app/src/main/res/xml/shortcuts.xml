                android:name="com.vivid.app.extra.SHORTCUT_ACTION"
                android:value="create_story" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="vivid_messages"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_messages"
        android:shortcutShortLabel="@string/shortcut_messages"
        android:shortcutLongLabel="@string/shortcut_messages">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.vivid.app"
