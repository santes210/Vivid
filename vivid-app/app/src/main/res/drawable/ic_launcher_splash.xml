<?xml version="1.0" encoding="utf-8"?>

<!--
    Logo estático para la SplashScreen de Android 12+.

    El área del icono es 288dp, equivalente a 1152x1152 px en xxxhdpi. El
    artwork ocupa el círculo visible de 192dp (768px), como pide la API de
    SplashScreen para un icono sin fondo propio.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="1152"
    android:viewportHeight="1152">

    <!-- Vivid + lente, centrados y escalados para el mask circular del splash. -->
    <group
        android:scaleX="32"
        android:scaleY="32"
        android:translateX="192"
        android:translateY="248">

        <path
            android:fillColor="@color/splash_screen_foreground"
            android:pathData="M2.5,3 L6.8,3 L12,16.4 L17.2,3 L21.5,3 L14.1,21 L9.9,21 Z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="@color/splash_screen_foreground"
            android:strokeWidth="1.35"
            android:pathData="M7.35,10.2 A4.65,4.65 0,1 0,16.65 10.2 A4.65,4.65 0,1 0,7.35 10.2" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="@color/splash_screen_foreground"
            android:strokeWidth="0.9"
            android:pathData="M9.15,10.2 A2.85,2.85 0,1 0,14.85 10.2 A2.85,2.85 0,1 0,9.15 10.2" />
        <path
            android:fillColor="@color/splash_screen_foreground"
            android:pathData="M10.65,10.2 A1.35,1.35 0,1 0,13.35 10.2 A1.35,1.35 0,1 0,10.65 10.2 Z" />
        <path
            android:fillColor="@color/splash_screen_foreground"
            android:pathData="M8.55,7.9 L9.25,7.35 L9.8,8.05 L9.1,8.6 Z" />
    </group>

</vector>
