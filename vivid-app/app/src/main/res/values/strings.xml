    <string name="app_name">Vivid</string>

    <!--
      default_web_client_id NO se define aquí a mano: lo genera el plugin
      google-services (com.google.gms.google-services) durante el build a
      partir del oauth_client con client_type 3 de google-services.json
      (que ya existe en el proyecto). Definirlo duplicado a mano arriesgaba
      un recurso duplicado y una fuente de verdad dividida.

      AuthScreen lo lee por nombre con Resources.getIdentifier() para no
      romper la compilación cuando el google-services.json inyectado en CI
      es un placeholder sin oauth_client (PRs de forks).
    -->

