# Podfile para Vivid iOS
# Firebase iOS SDK + Google Sign-In

platform :ios, '16.0'
use_frameworks!

target 'iosApp' do
  # Firebase (autenticación, Firestore, Storage, Messaging, Crashlytics, Analytics)
  pod 'Firebase/Auth', '~> 11.0'
  pod 'Firebase/Firestore', '~> 11.0'
  pod 'Firebase/Storage', '~> 11.0'
  pod 'Firebase/Messaging', '~> 11.0'
  pod 'Firebase/Crashlytics', '~> 11.0'
  pod 'Firebase/Analytics', '~> 11.0'
  pod 'Firebase/Performance', '~> 11.0'

  # Google Sign-In
  pod 'GoogleSignIn', '~> 7.1'

  # Imágenes (equivalente a Coil en Android)
  pod 'Kingfisher', '~> 7.12'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      # Swift 5.9+ (Xcode 15+)
      config.build_settings.delete 'CODE_SIGNING_ALLOWED'
    end
  end
end
